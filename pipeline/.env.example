# TerraLens — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit your actual .env file to version control.

# ─── LLM Provider ──────────────────────────────────────────────────────────
# Default: groq (free tier, fast, open-source models)
# Options: groq | gemini | openai | xai
LLM_PROVIDER=groq

# ─── Groq (recommended — open-source, fast, free tier available) ───────────
# Get your free API key at: https://console.groq.com
# Recommended models: llama-3.3-70b-versatile | qwen-2.5-32b | llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Alternative: Google Gemini ────────────────────────────────────────────
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ─── Alternative: OpenAI ───────────────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ─── Alternative: xAI (Grok) ───────────────────────────────────────────────
# XAI_API_KEY=
# XAI_MODEL=grok-3

# ─── Conversation (Chat) Settings ──────────────────────────────────────────
JOBS_DB=data/conversations.sqlite3
CHAT_REQUESTS_PER_HOUR=20
CHAT_REQUESTS_PER_DAY=100

# ─── Place & Vector Data Providers ─────────────────────────────────────────
PHOTON_URL=https://photon.komoot.io/api/
OVERPASS_URL=https://overpass-api.de/api/interpreter
WORLD_CACHE_DIR=data/world-cache

# ─── Durable Search Backend ────────────────────────────────────────────────
SEARCH_DB=data/search.sqlite3
SEARCH_WORKERS=4
SEARCH_MAX_PENDING=32
SEARCH_VECTOR_CHUNK_SIZE=1000
SEARCH_PARSER_SAMPLE_VALUES=20

# Set to 1 to enable natural-language search plan parsing via Groq (or configured provider)
SEARCH_PARSER_ENABLED=0

# Optional: override search parser with a different model/endpoint/key
# SEARCH_PARSER_MODEL=llama-3.1-8b-instant
# SEARCH_PARSER_BASE_URL=https://api.groq.com/openai/v1
# SEARCH_PARSER_API_KEY=

# ─── Optional Source Catalog & Execution Budgets ───────────────────────────
# BUNDLE_CATALOG_ROOTS=/absolute/catalog/root
# SEARCH_OSM_CATALOG=/absolute/provider-layers.json
# SEARCH_ASSOCIATION_POLICIES=/absolute/association-policies.json
# SEARCH_UNIT_BUDGET=100
# SEARCH_TIME_BUDGET_SECONDS=300
